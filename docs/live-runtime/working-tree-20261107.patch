+def _copy_missing_tree(src_dir: Path, dst_dir: Path) -> int:
+    if not src_dir.is_dir():
+        return 0
+    copied = 0
+    for root, dirs, files in os.walk(src_dir):
+        dirs[:] = [d for d in dirs if d not in _SKIP_SYNC_DIRS]
+        rel_root = Path(root).relative_to(src_dir)
+        target_root = dst_dir / rel_root
+        target_root.mkdir(parents=True, exist_ok=True)
+        for fname in files:
+            if fname == "ppt-master.install.json":
+                continue
+            src_file = Path(root) / fname
+            dst_file = target_root / fname
+            if not dst_file.exists():
+                try:
+                    _atomic_write_text(
+                        dst_file,
+                        src_file.read_text(encoding="utf-8", errors="ignore"),
+                    )
+                    copied += 1
+                except OSError:
+                    continue
+    return copied
+
+
+def seed_initial_evolution_library(global_root: Path) -> dict[str, int]:
+    """Idempotently seed a user's Argus home (``global_root``) with the common
+    initial 3-layer self-evolved library (``skills``, ``wiki``, ``tools``, and
+    ``reviewed-facts.md``) without overwriting user-evolved files.
+    """
+    from ..core.paths import (
+        reviewed_facts_digest_path,
+        shared_skills_root,
+        tools_root,
+        wiki_root,
+    )
+
+    global_root = Path(global_root)
+    harness = _initial_seed_harness_root()
+    skills_copied = _copy_missing_tree(
+        harness / "shared_skills",
+        shared_skills_root(global_root),
+    )
+    wiki_copied = _copy_missing_tree(
+        harness / "shared_wiki",
+        wiki_root(global_root),
+    )
+    tools_copied = _copy_missing_tree(
+        harness / "shared_tools",
+        tools_root(global_root),
+    )
+    rf_dst = reviewed_facts_digest_path(global_root)
+    rf_src = harness / "shared-reviewed-facts.md"
+    rf_seeded = 0
+    if rf_src.is_file() and (not rf_dst.exists() or rf_dst.stat().st_size == 0):
+        rf_dst.parent.mkdir(parents=True, exist_ok=True)
+        _atomic_write_text(rf_dst, rf_src.read_text(encoding="utf-8"))
+        rf_seeded = 1
+    return {
+        "skills": skills_copied,
+        "wiki": wiki_copied,
+        "tools": tools_copied,
+        "reviewed_facts": rf_seeded,
+    }
+
+
+def _harvest_verified_project_tools(
+    project_workdir: Path,
+    proj_tools: Path,
+    proj_wiki: Path | None = None,
+) -> int:
+    """Automatically harvest kernel-verified Lean 4 proofs (``lean_check.json``
+    with ``status == "success"`` and empty ``proof_holes``), Reviewer-supported
+    verification scripts, and Reviewer-supported mathematical proof playbooks
+    from ``project_workdir / "research"`` into ``proj_tools`` and ``proj_wiki``.
+    """
+    research_dir = project_workdir / "research"
+    if not research_dir.is_dir():
+        return 0
+    slug = project_workdir.name
+    dest_base = proj_tools / "results_tools" / f"c{slug}"
+    harvested = 0
+
+    # 1. Harvest kernel-verified Lean 4 sources
+    for lc_path in research_dir.rglob("lean_check.json"):
+        if any(part in _SKIP_SYNC_DIRS or part in {".autors", "openai_manuscript"} for part in lc_path.parts):
+            continue
+        try:
+            lc = json.loads(lc_path.read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            continue
+        if (
+            lc.get("status") == "success"
+            and lc.get("exit_code") == 0
+            and not lc.get("proof_holes")
+        ):
+            for lean_file in lc_path.parent.glob("*.lean"):
+                dst = dest_base / f"{lean_file.name}.template"
+                if not dst.exists():
+                    dst.parent.mkdir(parents=True, exist_ok=True)
+                    _atomic_write_text(
+                        dst,
+                        lean_file.read_text(encoding="utf-8", errors="ignore"),
+                    )
+                    harvested += 1
+
+    # 2. Harvest Reviewer-supported verification scripts & proof playbooks recorded in MATH_STATE.json
+    ms_path = research_dir / "MATH_STATE.json"
+    if ms_path.is_file():
+        try:
+            ms = json.loads(ms_path.read_text(encoding="utf-8"))
+            for ev in ms.get("evidence", ()):
+                if ev.get("verdict") != "supports":
+                    continue
+                art = str(ev.get("artifact") or "").strip()
+                src = project_workdir / art
+                if not src.is_file() or src.stat().st_size >= 250_000:
+                    continue
+                if art.endswith((".py", ".lean", ".cpp", ".gp", ".sage")):
+                    dst_name = f"{src.name}.template" if art.endswith(".lean") else src.name
+                    dst = dest_base / dst_name
+                    if not dst.exists():
+                        dst.parent.mkdir(parents=True, exist_ok=True)
+                        _atomic_write_text(
+                            dst,
+                            src.read_text(encoding="utf-8", errors="ignore"),
+                        )
+                        harvested += 1
+                elif proj_wiki is not None and art.endswith((".md", ".tex")) and "literature" not in art:
+                    wiki_dst = proj_wiki / "pages" / f"c{slug}" / f"{src.parent.name}_{src.stem}.md"
+                    if not wiki_dst.exists():
+                        wiki_dst.parent.mkdir(parents=True, exist_ok=True)
+                        _atomic_write_text(
+                            wiki_dst,
+                            src.read_text(encoding="utf-8", errors="ignore"),
+                        )
+                        harvested += 1
+        except (OSError, ValueError):
+            pass
+
+    return harvested
+
+
+def sync_project_evolution_library(
+    global_root: Path,
+    project_workdir: Path,
+) -> dict[str, int]:
+    """Two-way non-destructive sync between a user's Argus home (``global_root``)
+    and a project workdir's ``.autors/<slug>/{wiki,tools}``:
+    1. Automatically harvest any newly verified Lean 4 proofs or Reviewer-supported
+       verifier scripts from ``project_workdir/research/`` into ``.autors/<slug>/tools/``.
+    2. Promote any new wiki pages or tools evolved inside the project up into
+       the user's ``<global_root>/{wiki,tools}``.
+    3. Stage all wiki pages and tools in the user's ``<global_root>/{wiki,tools}``
+       into the project workdir so every project on that user's Argus shares and
+       compounds the user's evolved library.
+    """
+    from ..core.paths import tools_root, wiki_root
+
+    global_root = Path(global_root)
+    project_workdir = Path(project_workdir)
+    slug = project_workdir.name
+    proj_autors = project_workdir / ".autors" / slug
+    proj_wiki = proj_autors / "wiki"
+    proj_tools = proj_autors / "tools"
+    user_wiki = wiki_root(global_root)
+    user_tools = tools_root(global_root)
+
+    harvested = _harvest_verified_project_tools(project_workdir, proj_tools, proj_wiki)
+    up_wiki = _copy_missing_tree(proj_wiki, user_wiki)
+    up_tools = _copy_missing_tree(proj_tools, user_tools)
+    down_wiki = _copy_missing_tree(user_wiki, proj_wiki)
+    down_tools = _copy_missing_tree(user_tools, proj_tools)
+    return {
+        "harvested_tools": harvested,
+        "promoted_wiki": up_wiki,
+        "promoted_tools": up_tools,
+        "staged_wiki": down_wiki,
+        "staged_tools": down_tools,
+    }
+
