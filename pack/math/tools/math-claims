#!/usr/bin/env python3
# Read English/Chinese math claims tables, check evidence paths, and optionally recompile Lean.
"""math-claims: read the claims tables in reports and sum them up.

    math-claims <report.md | folder> ...           counts by basis and by source
    math-claims --list <report.md | folder> ...    every claim, one per line
    math-claims --check <report.md | folder> ...   also compile the Lean behind "proved in Lean"
                                                    and look for the files behind "checked by computation"
    math-claims --check-paths <report.md | folder> ...
                                                 check named evidence files for every basis and table column counts
                                                 (combine with --check to also compile Lean)

A claims table is a Markdown table with the columns Claim | Source | Basis | Evidence
(or 命题 | 出处 | 依据 | 证据, 主张 | 来源 | 依据 | 证据). Folders are searched for *.md files.
Put evidence paths in backticks. Otherwise, slash paths and filenames with an
alphabetic extension are recognized; prose locators such as "Theorem 1.4" are not.
Leading source labels take precedence over later references to other sources.
"""
import collections
import re
import subprocess
import sys
from pathlib import Path

HEADERS = (("claim", "source", "basis", "evidence"), ("命题", "出处", "依据", "证据"),
           ("主张", "来源", "依据", "证据"))
BASIS = (("lean", ("lean",)), ("computation", ("comput", "计算")), ("hand", ("hand", "人工", "手算")),
         ("conditional", ("conditional", "依赖", "条件于")), ("open", ("open", "未证", "未定")),
         ("refuted", ("refut", "推翻", "反驳")))
SOURCE = (("paper", ("paper", "原文", "论文")), ("ours", ("ours", "我们", "本文")), ("earlier draft", ("earlier", "draft", "旧稿")),
          ("literature", ("literature", "文献", "arxiv", "doi")))


def cells(line):
    parts = re.split(r"(?<!\\)\|", line.strip().strip("|"))
    return [p.strip().replace("\\|", "|") for p in parts]


def tables(path, strict=False):
    lines = path.read_text(errors="replace").splitlines()
    rows = []
    for i, line in enumerate(lines):
        head = [c.lower() for c in cells(line)] if line.lstrip().startswith("|") else []
        if tuple(head[:4]) in HEADERS and i + 1 < len(lines) and re.match(r"^\s*\|?[\s:|-]+\|?\s*$", lines[i + 1]):
            if strict and len(head) != 4:
                raise ValueError(f"{path}:{i + 1}: expected 4 claims columns, found {len(head)}.")
            for number, row in enumerate(lines[i + 2:], i + 3):
                if not row.lstrip().startswith("|"):
                    break
                c = cells(row)
                if strict and len(c) != 4:
                    raise ValueError(f"{path}:{number}: expected 4 claims columns, found {len(c)}.")
                c += ["", "", "", ""]
                rows.append({"claim": c[0], "source": c[1], "basis": c[2], "evidence": c[3], "file": path})
    return rows


def kind(text, table):
    low = text.lower().strip()
    if table is SOURCE:
        for name, keys in table:
            if any(re.match(rf"^{re.escape(k)}(?![a-z0-9_])", low) for k in keys):
                return name
    for name, keys in table:
        if any(k in low for k in keys):
            return name
    return "other"


def evidence_paths(row):
    found = re.findall(r"`([^`]+)`", row["evidence"])
    if not found:
        found = [w for w in re.split(r"[\s,;]+", row["evidence"])
                 if "/" in w or re.search(r"\.[A-Za-z][A-Za-z0-9]*(?:#.*)?$", w)]
    paths = []
    for name in found:
        for base in [row["file"].parent, *row["file"].parents]:
            if (base / name).exists():
                paths.append(base / name)
                break
        else:
            paths.append(None if not name.strip() else Path(name))
    return paths


def check(rows, all_paths=False, verify_lean=True):
    problems = 0
    for row in rows:
        b = kind(row["basis"], BASIS)
        if b not in ("lean", "computation") and not all_paths:
            continue
        paths = evidence_paths(row)
        if not paths and b in ("lean", "computation"):
            print(f"- {row['file']}: \"{row['claim'][:70]}\" is {row['basis']} but names no file.")
            problems += 1
        for p in paths:
            if p is None or not p.is_file():
                print(f"- {row['file']}: \"{row['claim'][:70]}\": {p or 'evidence'} not found.")
                problems += 1
            elif verify_lean and b == "lean" and p.suffix == ".lean":
                done = subprocess.run(["math-lean-verify", str(p)], capture_output=True, text=True)
                if done.returncode != 0:
                    print(f"- {row['file']}: \"{row['claim'][:70]}\": {p} does not pass math-lean-verify.")
                    print("  " + "\n  ".join(done.stdout.strip().splitlines()[1:4]))
                    problems += 1
    success = ("Every referenced evidence file checked is in order." if all_paths
               else "Every Lean and computation file checked is in order.")
    print(success if not problems else f"{problems} thing(s) to look at.")
    return 1 if problems else 0


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    flags = {a for a in argv if a.startswith("--")}
    targets = [Path(a) for a in argv if not a.startswith("--")]
    if not targets:
        print(__doc__.strip())
        return 2
    files = []
    for t in targets:
        files += sorted(t.rglob("*.md")) if t.is_dir() else [t]
    try:
        rows = [r for f in files for r in tables(f, strict="--check-paths" in flags)]
    except ValueError as error:
        print(error, file=sys.stderr)
        return 1
    if not rows:
        print("No claims table found.")
        return 1
    if "--list" in flags:
        for r in rows:
            print(f"[{kind(r['basis'], BASIS)} · {kind(r['source'], SOURCE)}] {r['claim']}  ({r['file']})")
    by_basis = collections.Counter(kind(r["basis"], BASIS) for r in rows)
    by_source = collections.Counter(kind(r["source"], SOURCE) for r in rows)
    reports = len({r["file"] for r in rows})
    print(f"{len(rows)} claims in {reports} report(s).")
    print("  by basis:  " + ", ".join(f"{k} {v}" for k, v in by_basis.most_common()))
    print("  by source: " + ", ".join(f"{k} {v}" for k, v in by_source.most_common()))
    if "--check" in flags or "--check-paths" in flags:
        return check(rows, all_paths="--check-paths" in flags, verify_lean="--check" in flags)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
