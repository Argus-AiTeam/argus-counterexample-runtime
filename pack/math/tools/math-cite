#!/usr/bin/env python3
"""math-cite: fetch a cited work so you can read the proposition you cite.

    math-cite arXiv:2002.08717v2      # or 2002.08717, math/0206203v2
    math-cite 10.4310/CAG.2009.v17.n4.a4
    math-cite <id> --into sources     # where to save (default: ./sources)

Prints what the work is (title, authors, version, date) and saves what is openly available:
the arXiv PDF and, when present, its TeX source. For a DOI it prints the publisher's record; the
full text is saved only when the DOI resolves to an open PDF. Read the proposition itself, then
quote it, with its number and the version you read, in your report. When the text cannot be
obtained, say so in the report: "could not check".
"""
import json
import re
import sys
import urllib.parse
import urllib.error
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path

UA = {"User-Agent": "argus-math-cite/0.1 (mailto:argus@example.invalid)"}
ATOM = "{http://www.w3.org/2005/Atom}"


def get(url, timeout=60):
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=timeout) as r:
        return r.read(), r.headers.get("Content-Type", ""), r.geturl()


def save(data, path):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(data)
    return path


def arxiv(ident, into):
    data, _, _ = get("https://export.arxiv.org/api/query?id_list=" + urllib.parse.quote(ident))
    entry = ET.fromstring(data).find(ATOM + "entry")
    if entry is None or entry.find(ATOM + "title") is None:
        print(f"arXiv:{ident}: not found.")
        return 1
    title = " ".join(entry.findtext(ATOM + "title").split())
    authors = ", ".join(a.findtext(ATOM + "name") for a in entry.findall(ATOM + "author"))
    abs_url = entry.findtext(ATOM + "id")
    version = abs_url.rsplit("/", 1)[-1]
    print(f"arXiv:{version} — {title}")
    print(f"  {authors}")
    print(f"  first posted {entry.findtext(ATOM + 'published')[:10]}, this version {entry.findtext(ATOM + 'updated')[:10]}")
    stem = version.replace("/", "_")
    try:
        pdf, _, _ = get(f"https://arxiv.org/pdf/{version}")
        print(f"  saved {save(pdf, into / f'arxiv-{stem}.pdf')}")
    except Exception as error:
        print(f"  PDF not saved: {error}")
    try:
        src, kind, _ = get(f"https://arxiv.org/e-print/{version}")
        suffix = ".tar.gz" if src[:2] == b"\x1f\x8b" else ".tex"
        print(f"  saved {save(src, into / f'arxiv-{stem}-source{suffix}')} (TeX source)")
    except Exception:
        pass
    if not re.search(r"v\d+$", ident):
        print(f"  You asked for the latest version; cite it as arXiv:{version}.")
    return 0


def doi(ident, into):
    try:
        data, _, _ = get("https://api.crossref.org/works/" + urllib.parse.quote(ident))
        work = json.loads(data)["message"]
    except Exception as error:
        print(f"doi:{ident}: no record found ({error}). Check the DOI; if it is right, the citation cannot be checked here.")
        return 1
    title = " ".join((work.get("title") or ["(untitled)"])[0].split())
    authors = ", ".join(f"{a.get('given', '')} {a.get('family', '')}".strip() for a in work.get("author", []))
    venue = (work.get("container-title") or [""])[0]
    year = (work.get("issued", {}).get("date-parts") or [[None]])[0][0]
    pages = work.get("page", "")
    print(f"doi:{ident} — {title}")
    print(f"  {authors}")
    print(f"  {venue} {work.get('volume', '')}{'(' + work['issue'] + ')' if work.get('issue') else ''} {pages} ({year})".rstrip())
    try:
        body, kind, final = get("https://doi.org/" + ident)
        if "pdf" in kind:
            print(f"  saved {save(body, into / ('doi-' + re.sub(r'[^A-Za-z0-9._-]', '_', ident) + '.pdf'))}")
        else:
            print(f"  resolves to {final}; the full text was not saved. Use an arXiv or open copy, or say it could not be checked.")
    except urllib.error.HTTPError as error:
        if error.code in (401, 403):
            print(f"  the publisher refused the download (HTTP {error.code}); the full text was not saved. Use an arXiv or open copy, or say it could not be checked.")
        else:
            print(f"  the DOI does not resolve (HTTP {error.code}).")
    except Exception as error:
        print(f"  the DOI could not be followed ({error}).")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    into = Path("sources")
    if "--into" in argv:
        i = argv.index("--into")
        into = Path(argv[i + 1])
        argv = argv[:i] + argv[i + 2:]
    code = 0
    for ident in argv:
        ident = ident.strip()
        bare = re.sub(r"^(arxiv:|https?://arxiv\.org/(abs|pdf)/)", "", ident, flags=re.I)
        if re.match(r"^(\d{4}\.\d{4,5}|[a-z-]+(\.[A-Z]{2})?/\d{7})(v\d+)?$", bare):
            code |= arxiv(bare, into)
        elif re.match(r"^(doi:|https?://(dx\.)?doi\.org/)?10\.\d{4,9}/\S+$", ident, re.I):
            code |= doi(re.sub(r"^(doi:|https?://(dx\.)?doi\.org/)", "", ident, flags=re.I), into)
        else:
            print(f"{ident}: not an arXiv id or a DOI.")
            code = 1
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
